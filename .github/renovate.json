{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":semanticCommits"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Handle Go version updates",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "matchUpdateTypes": ["major", "minor"],
      "semanticCommitType": "chore"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "semanticCommitType": "chore",
      "enabled": true
    },
    {
      "description": "Handle Go toolchain updates",
      "matchManagers": ["gomod"],
      "matchDepNames": ["toolchain"],
      "rangeStrategy": "pin",
      "semanticCommitType": "chore"
    },
    {
      "description": "Automerge non-major updates once every status check has passed. Renovate merges them itself, because GitHub's native auto-merge merges a pull request with failing checks when the branch requires none.",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "platformAutomerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
